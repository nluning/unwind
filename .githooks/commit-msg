#!/bin/sh
# Rejects commit messages carrying Claude attribution (see CLAUDE.md, "Working preferences").
# Runs as commit-msg, not pre-commit: the message doesn't exist yet at pre-commit time.

if grep -iEq 'co-authored-by:.*(claude|anthropic)|noreply@anthropic\.com|generated with .*claude code' "$1"; then
  echo "commit rejected: message contains Claude attribution (Co-Authored-By / Generated with Claude Code)." >&2
  echo "Remove that line and commit again." >&2
  exit 1
fi
